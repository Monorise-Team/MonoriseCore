// Baza monorise_core (04-data/data-models-core.md, ADR-0096).
// Schemat "auth": tabele biblioteki logowania (Better Auth) — konta logowania, sesje, hasła, klucze JWT.
// Schemat "public": dane firm. Każda tabela z danymi firmy ma RLS (migracja), a aplikacja łączy się
// rolą core_app bez uprawnień właściciela tabel (ADR-0037).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "auth"]
}

// ── Logowanie (Better Auth) ───────────────────────────────────────────────────────────────────────

/// Konto logowania. Identyfikator jest taki sam jak Account.id (sub w tokenie).
model AuthUser {
  id            String                  @id @db.Uuid
  name          String
  email         String                  @unique @db.Citext
  emailVerified Boolean                 @default(false)
  image         String?
  createdAt     DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime                @updatedAt @db.Timestamptz(3)
  sessions      AuthSession[]
  credentials   AuthCredential[]
  account       Account?
  oauthClients  AuthOAuthClient[]
  oauthRefresh  AuthOAuthRefreshToken[]
  oauthAccess   AuthOAuthAccessToken[]
  oauthConsents AuthOAuthConsent[]

  @@map("users")
  @@schema("auth")
}

model AuthSession {
  id           String                  @id @db.Uuid
  expiresAt    DateTime                @db.Timestamptz(3)
  token        String                  @unique
  createdAt    DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime                @updatedAt @db.Timestamptz(3)
  ipAddress    String?
  userAgent    String?
  userId       String                  @db.Uuid
  user         AuthUser                @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthRefresh AuthOAuthRefreshToken[]
  oauthAccess  AuthOAuthAccessToken[]

  @@index([userId])
  @@map("sessions")
  @@schema("auth")
}

/// Sposób logowania konta (w Better Auth: "account"), np. hasło.
model AuthCredential {
  id                    String    @id @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("credentials")
  @@schema("auth")
}

model AuthVerification {
  id         String   @id @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
  @@schema("auth")
}

/// Klucze podpisujące tokeny JWT, publikowane jako JWKS (ADR-0023).
model AuthJwks {
  id         String    @id @db.Uuid
  publicKey  String
  privateKey String
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime? @db.Timestamptz(3)
  alg        String?
  crv        String?

  @@map("jwks")
  @@schema("auth")
}

// ── Logowanie produktów: serwer OAuth 2.1 (Better Auth, wtyczka oauth-provider) ────────────────
// Listy to tablice PostgreSQL; pola JSON biblioteka zapisuje jako tekst.

/// Aplikacja, która loguje użytkowników przez Core (np. AvenMail w przeglądarce, na telefonie).
model AuthOAuthClient {
  id                               String                    @id @db.Uuid
  clientId                         String                    @unique
  clientSecret                     String?
  clientDiscoveryId                String?
  disabled                         Boolean?                  @default(false)
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?
  scopes                           String[]                  @default([])
  clientCredentialsScopes          String[]                  @default([])
  userId                           String?                   @db.Uuid
  user                             AuthUser?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                        DateTime?                 @default(now()) @db.Timestamptz(3)
  updatedAt                        DateTime?                 @updatedAt @db.Timestamptz(3)
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         String[]                  @default([])
  tos                              String?
  policy                           String?
  softwareId                       String?
  softwareVersion                  String?
  softwareStatement                String?
  redirectUris                     String[]
  postLogoutRedirectUris           String[]                  @default([])
  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?
  applicationType                  String?
  jwks                             String?
  jwksUri                          String?
  grantTypes                       String[]                  @default([])
  responseTypes                    String[]                  @default([])
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean?                  @default(false)
  referenceId                      String?
  metadata                         String?
  resources                        AuthOAuthClientResource[]
  refreshTokens                    AuthOAuthRefreshToken[]
  accessTokens                     AuthOAuthAccessToken[]
  consents                         AuthOAuthConsent[]

  @@map("oauth_clients")
  @@schema("auth")
}

/// API, dla którego wydawany jest token (odbiorca, aud), np. https://aven.monorise.studio.
model AuthOAuthResource {
  id                            String                    @id @db.Uuid
  identifier                    String                    @unique
  name                          String
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?
  signingKeyId                  String?
  allowedScopes                 String[]                  @default([])
  customClaims                  String?
  dpopBoundAccessTokensRequired Boolean?                  @default(false)
  disabled                      Boolean?                  @default(false)
  createdAt                     DateTime?                 @default(now()) @db.Timestamptz(3)
  updatedAt                     DateTime?                 @updatedAt @db.Timestamptz(3)
  policyVersion                 Int?                      @default(1)
  metadata                      String?
  clients                       AuthOAuthClientResource[]

  @@map("oauth_resources")
  @@schema("auth")
}

model AuthOAuthClientResource {
  id         String            @id @db.Uuid
  clientId   String
  client     AuthOAuthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resourceId String
  resource   AuthOAuthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)
  metadata   String?
  createdAt  DateTime?         @default(now()) @db.Timestamptz(3)

  @@index([clientId])
  @@index([resourceId])
  @@map("oauth_client_resources")
  @@schema("auth")
}

model AuthOAuthRefreshToken {
  id                      String                 @id @db.Uuid
  token                   String                 @unique
  clientId                String
  client                  AuthOAuthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?                @db.Uuid
  session                 AuthSession?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String                 @db.Uuid
  user                    AuthUser               @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]               @default([])
  requestedUserInfoClaims String[]               @default([])
  expiresAt               DateTime               @db.Timestamptz(3)
  createdAt               DateTime               @default(now()) @db.Timestamptz(3)
  revoked                 DateTime?              @db.Timestamptz(3)
  rotatedAt               DateTime?              @db.Timestamptz(3)
  rotationReplayResponse  String?
  rotationReplayExpiresAt DateTime?              @db.Timestamptz(3)
  authTime                DateTime?              @db.Timestamptz(3)
  confirmation            String?
  scopes                  String[]
  accessTokens            AuthOAuthAccessToken[]

  @@index([clientId])
  @@index([userId])
  @@map("oauth_refresh_tokens")
  @@schema("auth")
}

model AuthOAuthAccessToken {
  id                      String                 @id @db.Uuid
  token                   String                 @unique
  clientId                String
  client                  AuthOAuthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?                @db.Uuid
  session                 AuthSession?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String?                @db.Uuid
  user                    AuthUser?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]               @default([])
  requestedUserInfoClaims String[]               @default([])
  refreshId               String?                @db.Uuid
  refresh                 AuthOAuthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)
  expiresAt               DateTime               @db.Timestamptz(3)
  createdAt               DateTime               @default(now()) @db.Timestamptz(3)
  revoked                 DateTime?              @db.Timestamptz(3)
  confirmation            String?
  scopes                  String[]

  @@index([clientId])
  @@index([userId])
  @@map("oauth_access_tokens")
  @@schema("auth")
}

model AuthOAuthConsent {
  id                      String          @id @db.Uuid
  clientId                String
  client                  AuthOAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                  String?         @db.Uuid
  user                    AuthUser?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  resources               String[]        @default([])
  requestedUserInfoClaims String[]        @default([])
  scopes                  String[]
  createdAt               DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime        @updatedAt @db.Timestamptz(3)

  @@index([clientId])
  @@index([userId])
  @@map("oauth_consents")
  @@schema("auth")
}

model AuthOAuthClientAssertion {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(3)

  @@map("oauth_client_assertions")
  @@schema("auth")
}

// ── Firmy ─────────────────────────────────────────────────────────────────────────────────────────

enum OrganizationStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  OFFBOARDING
  DELETED

  @@schema("public")
}

enum OrganizationCreatedVia {
  OPERATOR
  SELF_SIGNUP

  @@schema("public")
}

model Organization {
  id                   String                 @id @db.Uuid
  name                 String
  status               OrganizationStatus     @default(PENDING_VERIFICATION)
  createdVia           OrganizationCreatedVia
  ownerAccountId       String?                @unique @db.Uuid
  ownerAccount         Account?               @relation("OrganizationOwner", fields: [ownerAccountId], references: [id], onDelete: Restrict)
  mfaRequiredForAll    Boolean                @default(false)
  suspendedAt          DateTime?              @db.Timestamptz(3)
  offboardingStartedAt DateTime?              @db.Timestamptz(3)
  createdAt            DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime               @updatedAt @db.Timestamptz(3)
  domains              OrganizationDomain[]
  employees            Employee[]
  accounts             Account[]              @relation("OrganizationAccounts")
  invitations          Invitation[]
  units                OrganizationUnit[]
  unitMemberships      UnitMembership[]
  roles                Role[]
  roleAssignments      RoleAssignment[]
  entitlements         Entitlement[]
  appAccesses          AppAccess[]
  outboxEvents         OutboxEvent[]
  auditLogs            AuditLog[]
  idempotencyKeys      IdempotencyKey[]
  mailOutbox           MailOutbox[]

  @@map("organizations")
  @@schema("public")
}

enum DomainStatus {
  PENDING
  VERIFIED
  FAILED
  REVOKED

  @@schema("public")
}

enum DomainVerificationMethod {
  DNS_TXT
  OPERATOR

  @@schema("public")
}

/// Domena e-mail przypisana do firmy (ADR-0019).
/// Zasada „wygrywa weryfikacja”: wiele firm może mieć niezweryfikowane roszczenie (PENDING/FAILED)
/// do tej samej domeny; globalna unikalność dotyczy wyłącznie statusu VERIFIED (częściowy indeks
/// `organization_domains_domain_verified_key`), a jedna firma ma co najwyżej jedną domenę główną
/// (`organization_domains_organizationId_primary_key`).
model OrganizationDomain {
  id                    String                   @id @db.Uuid
  organizationId        String                   @db.Uuid
  organization          Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domain                String                   @db.Citext
  status                DomainStatus             @default(PENDING)
  verificationMethod    DomainVerificationMethod
  verificationTokenHash String?
  verifiedAt            DateTime?                @db.Timestamptz(3)
  lastCheckedAt         DateTime?                @db.Timestamptz(3)
  isPrimary             Boolean                  @default(false)
  createdAt             DateTime                 @default(now()) @db.Timestamptz(3)

  @@unique([organizationId, domain])
  @@index([organizationId])
  @@map("organization_domains")
  @@schema("public")
}

enum EmployeeStatus {
  ACTIVE
  FORMER
  ANONYMIZED

  @@schema("public")
}

/// Pracownik firmy, niezależny od konta (ADR-0031). Produkty odwołują się do employeeId.
model Employee {
  id              String           @id @db.Uuid
  organizationId  String           @db.Uuid
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  firstName       String
  lastName        String
  workEmail       String?          @db.Citext
  jobTitle        String?
  status          EmployeeStatus   @default(ACTIVE)
  anonymizedAt    DateTime?        @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  account         Account?
  unitMemberships UnitMembership[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("employees")
  @@schema("public")
}

enum AccountStatus {
  INVITED
  ACTIVE
  DEACTIVATED

  @@schema("public")
}

/// Konto pracownika w firmie. Jeden adres e-mail to jedno konto w jednej firmie (ADR-0018).
model Account {
  id                String           @id @db.Uuid
  authUser          AuthUser         @relation(fields: [id], references: [id], onDelete: Cascade)
  organizationId    String           @db.Uuid
  organization      Organization     @relation("OrganizationAccounts", fields: [organizationId], references: [id], onDelete: Cascade)
  ownedOrganization Organization?    @relation("OrganizationOwner")
  employeeId        String           @unique @db.Uuid
  employee          Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  email             String           @db.Citext
  normalizedEmail   String           @unique @db.Citext
  status            AccountStatus    @default(INVITED)
  authzRevision     Int              @default(0)
  lastLoginAt       DateTime?        @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)
  deactivatedAt     DateTime?        @db.Timestamptz(3)
  invitations       Invitation[]
  roleAssignments   RoleAssignment[]
  appAccesses       AppAccess[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("accounts")
  @@schema("public")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED

  @@schema("public")
}

/// Zaproszenie pracownika do aktywacji konta INVITED (ADR-0021).
/// Co najwyżej jedno zaproszenie PENDING na konto (częściowy indeks unikalny w migracji).
model Invitation {
  id                 String           @id @db.Uuid
  organizationId     String           @db.Uuid
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accountId          String           @db.Uuid
  account            Account          @relation(fields: [organizationId, accountId], references: [organizationId, id], onDelete: Cascade)
  email              String           @db.Citext
  normalizedEmail    String           @db.Citext
  tokenHash          String           @unique
  status             InvitationStatus @default(PENDING)
  expiresAt          DateTime         @db.Timestamptz(3)
  invitedByAccountId String?          @db.Uuid
  acceptedAt         DateTime?        @db.Timestamptz(3)
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)
  mailOutbox         MailOutbox[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, accountId])
  @@index([organizationId, status])
  @@map("invitations")
  @@schema("public")
}

// ── Struktura firmy (ADR-0032) ────────────────────────────────────────────────────────────────────

enum UnitType {
  BRANCH
  DEPARTMENT
  TEAM

  @@schema("public")
}

enum UnitStatus {
  ACTIVE
  ARCHIVED

  @@schema("public")
}

/// Jednostka organizacyjna w pojedynczym drzewie firmy (ADR-0032). Brak parentId oznacza poziom firmy.
model OrganizationUnit {
  id             String             @id @db.Uuid
  organizationId String             @db.Uuid
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentId       String?            @db.Uuid
  parent         OrganizationUnit?  @relation("OrganizationUnitHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children       OrganizationUnit[] @relation("OrganizationUnitHierarchy")
  name           String
  type           UnitType
  status         UnitStatus         @default(ACTIVE)
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(3)
  memberships    UnitMembership[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, parentId])
  @@map("organization_units")
  @@schema("public")
}

enum UnitMembershipRole {
  MEMBER
  LEADER

  @@schema("public")
}

/// Przynależność pracownika do jednostki organizacyjnej (ADR-0032).
model UnitMembership {
  id             String             @id @db.Uuid
  organizationId String             @db.Uuid
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  unitId         String             @db.Uuid
  unit           OrganizationUnit   @relation(fields: [organizationId, unitId], references: [organizationId, id], onDelete: Cascade)
  employeeId     String             @db.Uuid
  employee       Employee           @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Cascade)
  role           UnitMembershipRole @default(MEMBER)
  joinedAt       DateTime           @default(now()) @db.Timestamptz(3)
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)

  @@unique([unitId, employeeId])
  @@index([organizationId])
  @@index([organizationId, unitId])
  @@index([organizationId, employeeId])
  @@map("unit_memberships")
  @@schema("public")
}

// ── Rejestr produktów i uprawnień (ADR-0036) ──────────────────────────────────────────────────────

/// Produkt platformy Monorise (np. timotime, avenmail). Dane platformy, bez organizationId i bez RLS.
model Product {
  id                   String        @id @db.Uuid
  key                  String        @unique
  name                 String
  registrationClientId String?       @unique
  createdAt            DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @db.Timestamptz(3)
  permissions          Permission[]
  roles                Role[]
  entitlements         Entitlement[]
  appAccesses          AppAccess[]
  auditLogs            AuditLog[]

  @@map("products")
  @@schema("public")
}

/// Uprawnienie zadeklarowane przez produkt lub platformę Core (ADR-0036).
/// Brak productId oznacza uprawnienie platformy (`core.*`). Uprawnień nie usuwamy — wycofane mają deprecatedAt.
model Permission {
  id              String           @id @db.Uuid
  key             String           @unique
  productId       String?          @db.Uuid
  product         Product?         @relation(fields: [productId], references: [id], onDelete: Restrict)
  description     String
  deprecatedAt    DateTime?        @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  rolePermissions RolePermission[]

  @@index([productId])
  @@map("permissions")
  @@schema("public")
}

// ── Role i przypisania ról (ADR-0033, ADR-0034, ADR-0035) ─────────────────────────────────────────

enum ScopeType {
  ORGANIZATION
  UNIT
  RESOURCE

  @@schema("public")
}

/// Rola: zestaw uprawnień platformy lub jednego produktu (ADR-0035).
/// Brak organizationId oznacza gotową rolę (szablon) współdzieloną przez firmy; brak productId — rolę platformową (core.*).
model Role {
  id               String           @id @db.Uuid
  organizationId   String?          @db.Uuid
  organization     Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId        String?          @db.Uuid
  product          Product?         @relation(fields: [productId], references: [id], onDelete: Restrict)
  key              String?          @unique
  name             String
  description      String?
  copiedFromRoleId String?          @db.Uuid
  copiedFromRole   Role?            @relation("RoleCopy", fields: [copiedFromRoleId], references: [id], onDelete: SetNull)
  copies           Role[]           @relation("RoleCopy")
  archivedAt       DateTime?        @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)
  permissions      RolePermission[]
  assignments      RoleAssignment[]

  @@index([organizationId])
  @@index([productId])
  @@map("roles")
  @@schema("public")
}

/// Powiązanie roli z uprawnieniem. Pole organizationId kopiuje wyzwalacz z roli, aby egzekwować RLS.
model RolePermission {
  roleId         String     @db.Uuid
  role           Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId   String     @db.Uuid
  permission     Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  organizationId String?    @db.Uuid

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@index([organizationId])
  @@map("role_permissions")
  @@schema("public")
}

/// Przypisanie roli kontu w firmie z zakresem i opcjonalnym okresem ważności (ADR-0033, ADR-0035).
model RoleAssignment {
  id                 String       @id @db.Uuid
  organizationId     String       @db.Uuid
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accountId          String       @db.Uuid
  account            Account      @relation(fields: [organizationId, accountId], references: [organizationId, id], onDelete: Cascade)
  roleId             String       @db.Uuid
  role               Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  scopeType          ScopeType
  scopeId            String?
  validFrom          DateTime?    @db.Timestamptz(3)
  validUntil         DateTime?    @db.Timestamptz(3)
  grantedByAccountId String       @db.Uuid
  createdAt          DateTime     @default(now()) @db.Timestamptz(3)

  @@index([organizationId])
  @@index([organizationId, accountId])
  @@index([organizationId, roleId])
  @@index([roleId])
  @@map("role_assignments")
  @@schema("public")
}

// ── Dziennik zdarzeń (ADR-0039) ───────────────────────────────────────────────────────────────────

enum AuditActorType {
  ACCOUNT
  OPERATOR
  SYSTEM
  PRODUCT

  @@schema("public")
}

/// Centralny, niezmienny dziennik zdarzeń (ADR-0039). Tylko dopisywanie; wpisy firm chronione przez RLS
/// i usuwane kaskadowo razem z firmą (ADR-0041). Brak organizationId oznacza zdarzenie platformy.
model AuditLog {
  id                   String         @id @db.Uuid
  organizationId       String?        @db.Uuid
  organization         Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorType            AuditActorType
  actorAccountId       String?        @db.Uuid
  actorOperatorId      String?        @db.Uuid
  productId            String?        @db.Uuid
  product              Product?       @relation(fields: [productId], references: [id], onDelete: Restrict)
  action               String
  resourceType         String
  resourceId           String
  metadata             Json           @default("{}")
  ipAddress            String?        @db.Inet
  userAgent            String?
  requestId            String?
  supportAccessGrantId String?        @db.Uuid
  createdAt            DateTime       @default(now()) @db.Timestamptz(3)

  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)], map: "audit_log_org_created_id_idx")
  @@index([organizationId, actorAccountId, createdAt(sort: Desc), id(sort: Desc)], map: "audit_log_org_actor_created_id_idx")
  @@index([organizationId, action, createdAt(sort: Desc), id(sort: Desc)], map: "audit_log_org_action_created_id_idx")
  @@index([organizationId, resourceType, resourceId, createdAt(sort: Desc), id(sort: Desc)], map: "audit_log_org_resource_created_id_idx")
  @@map("audit_log")
  @@schema("public")
}

// ── Dostęp firm do produktów i włączanie aplikacji (ADR-0035, ADR-0051, ADR-0052) ─────────────────

enum EntitlementSourceType {
  CONTRACT
  SUBSCRIPTION
  TRIAL
  MANUAL
  OFFER
  PACKAGE

  @@schema("public")
}

enum EntitlementStatus {
  ACTIVE
  SUSPENDED
  ENDED

  @@schema("public")
}

enum EntitlementSuspendedReason {
  OVERDUE

  @@schema("public")
}

/// Dostęp firmy do produktu (podzbiór modelu z 06-commercial/data-models-commercial.md, ADR-0051).
/// Co najwyżej jeden wpis o statusie innym niż ENDED na parę (firma, produkt) (częściowy indeks w migracji).
model Entitlement {
  id              String                      @id @db.Uuid
  organizationId  String                      @db.Uuid
  organization    Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId       String                      @db.Uuid
  product         Product                     @relation(fields: [productId], references: [id], onDelete: Restrict)
  planId          String?                     @db.Uuid
  sourceType      EntitlementSourceType
  sourceId        String?                     @db.Uuid
  status          EntitlementStatus           @default(ACTIVE)
  startsAt        DateTime                    @default(now()) @db.Timestamptz(3)
  endsAt          DateTime?                   @db.Timestamptz(3)
  suspendedReason EntitlementSuspendedReason?
  createdAt       DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                    @updatedAt @db.Timestamptz(3)

  @@index([organizationId])
  @@index([organizationId, productId])
  @@index([productId])
  @@map("entitlements")
  @@schema("public")
}

enum AppAccessStatus {
  ACTIVE
  REVOKED

  @@schema("public")
}

/// Pierwszy krok dostępu pracownika do produktu (ADR-0035). Co najwyżej jeden wiersz ACTIVE
/// na (accountId, productId); cofnięcie ustawia REVOKED i revokedAt (historia).
model AppAccess {
  id                 String          @id @db.Uuid
  organizationId     String          @db.Uuid
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accountId          String          @db.Uuid
  account            Account         @relation(fields: [organizationId, accountId], references: [organizationId, id], onDelete: Cascade)
  productId          String          @db.Uuid
  product            Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  status             AppAccessStatus @default(ACTIVE)
  grantedByAccountId String          @db.Uuid
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)
  revokedAt          DateTime?       @db.Timestamptz(3)

  @@index([organizationId])
  @@index([organizationId, accountId])
  @@index([organizationId, productId])
  @@index([productId])
  @@map("app_access")
  @@schema("public")
}

// ── Zdarzenia: tabela outbox (05-integration/events.md, ADR-0045) ─────────────────────────────────

/// Zdarzenia domenowe zapisywane w tej samej transakcji co zmiana stanu (wzorzec outbox).
/// Osobny proces wysyłkowy (relay) odczytuje wiersze z publishedAt = NULL.
model OutboxEvent {
  id              String        @id @db.Uuid
  organizationId  String?       @db.Uuid
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type            String
  version         Int
  resourceType    String
  resourceId      String
  resourceVersion Int
  payload         Json
  occurredAt      DateTime      @db.Timestamptz(3)
  publishedAt     DateTime?     @db.Timestamptz(3)
  /// Numer w kanale zdarzeń produktów, nadawany przy wysyłce (`outbox_publish_pending`)
  sequence        BigInt?       @unique

  @@index([organizationId])
  @@map("outbox_events")
  @@schema("public")
}

// ── Klucze powtórzeń żądań API (MonoriseCore#30, 05-integration/api-standards.md) ──────────────────

/// Zapisane odpowiedzi operacji tworzących (`POST`) powiązane z nagłówkiem `Idempotency-Key`.
/// Powtórzone żądanie z tym samym kluczem i treścią zwraca zapisaną odpowiedź bez ponownego wykonania operacji.
model IdempotencyKey {
  id             String       @id @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  principal      String
  key            String
  method         String
  path           String
  requestHash    String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime     @db.Timestamptz(3)

  @@unique([organizationId, principal, key])
  @@index([expiresAt, id])
  @@map("idempotency_keys")
  @@schema("public")
}

// ── Transakcyjna kolejka wysyłki poczty (MonoriseCore#60) ─────────────────────────────────────────

enum MailKind {
  INVITATION

  @@schema("public")
}

enum MailStatus {
  PENDING
  SENT
  FAILED
  CANCELLED

  @@schema("public")
}

/// Transakcyjna kolejka wiadomości e-mail (outbox poczty). Przechowuje wyłącznie referencję do zasobu
/// (nigdy treści wiadomości ani jawnego tokenu aktywacyjnego) i jest zapisywana w transakcji zmiany.
model MailOutbox {
  id             String       @id @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind           MailKind
  invitationId   String       @db.Uuid
  invitation     Invitation   @relation(fields: [organizationId, invitationId], references: [organizationId, id], onDelete: Cascade)
  status         MailStatus   @default(PENDING)
  attempts       Int          @default(0)
  nextAttemptAt  DateTime     @default(now()) @db.Timestamptz(3)
  lockedUntil    DateTime?    @db.Timestamptz(3)
  lastAttemptAt  DateTime?    @db.Timestamptz(3)
  sentAt         DateTime?    @db.Timestamptz(3)
  failedAt       DateTime?    @db.Timestamptz(3)
  lastError      String?
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@index([organizationId, invitationId])
  @@map("mail_outbox")
  @@schema("public")
}
