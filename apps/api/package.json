{
  "name": "@core/api",
  "version": "0.0.0",
  "private": true,
  "description": "Core API api.monorise.studio (Fastify): firmy, pracownicy, konta; dane firm zawsze przez RLS",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@core/contracts": "workspace:*",
    "@core/db": "workspace:*",
    "@monorise-team/events": "0.0.1-dev.6",
    "@monorise-team/permissions": "0.0.1-dev.6",
    "fastify": "^5.12.0",
    "jose": "^6.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@monorise-team/config": "0.0.1-dev.6",
    "@types/node": "^24.10.0",
    "eslint": "^10.15.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
